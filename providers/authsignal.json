  "features": [
    {
      "identifier": "username_and_password_authentication",
      "status": "not_supported",
      "description": "Authsignal does not store or check passwords. The existing identity provider keeps the first factor, or Authsignal replaces it with passkeys, OTP or magic links.",
      "links": ["https://docs.authsignal.com/actions-rules/actions/passwordless-login"],
      "plans": []
    },
    {
      "identifier": "social_sign_in_authentication",
      "status": "unknown",
      "plans": []
    },
    {
      "identifier": "passkey_authentication",
      "status": "supported",
      "description": "FIDO-certified passkey server with Web and mobile SDKs, the pre-built UI, passkey autofill and an uplift prompt that nudges users to enroll.",
      "links": [
        "https://docs.authsignal.com/authentication-methods/passkey/prebuilt-ui",
        "https://docs.authsignal.com/authentication-methods/passkey/web-sdk"
      ],
      "plans": ["Free trial", "Professional", "Enterprise"]
    },
    {
      "identifier": "email_passwordless_authentication",
      "status": "supported",
      "description": "Email OTP or an email magic link can replace the password. Rules can pick the method by risk, for example a magic link for low risk and a passkey for high risk.",
      "links": [
        "https://docs.authsignal.com/actions-rules/actions/passwordless-login",
        "https://docs.authsignal.com/authentication-methods/email/otp"
      ],
      "plans": ["Free trial", "Professional", "Enterprise"]
    },
    {
      "identifier": "phone_passwordless_authentication",
      "status": "supported",
      "description": "SMS OTP can replace the password, and WhatsApp OTP is available on the Enterprise plan.",
      "links": [
        "https://docs.authsignal.com/actions-rules/actions/passwordless-login",
        "https://docs.authsignal.com/authentication-methods/sms-otp"
      ],
      "plans": ["Free trial", "Professional", "Enterprise"]
    },
    {
      "identifier": "magic_link_authentication",
      "status": "supported",
      "description": "Email magic links, with a token duration set per tenant (10 minutes by default).",
      "links": [
