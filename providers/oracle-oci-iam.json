  "$schema": "https://schemas.cerberauth.com/identity-provider/draft/2024-09/provider.schema.json",
  "name": "Oracle OCI IAM",
  "abstract": "Identity and access management service of Oracle Cloud Infrastructure. Identity domains are containers for users, groups and security settings, offering single sign-on for Oracle and non-Oracle SaaS, cloud and on-premises applications, MFA, sign-on policies, adaptive security with third-party risk scores, federation with external identity providers, self-registration profiles, app gateways and a Microsoft AD bridge. Managed through the Console, the IAM API and the Identity Domains REST API. Identity domains replace Oracle Identity Cloud Service, which customers are migrating from.",
  "identifier": "oracle-oci-iam",
  "aliases": ["OCI IAM identity domains", "Oracle Identity Cloud Service"],
  "status": "active",
  "deploymentModels": ["saas"],
  "targetAudience": ["workforce", "b2c", "ciam"],
