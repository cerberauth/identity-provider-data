  "$schema": "https://schemas.cerberauth.com/identity-provider/draft/2024-09/provider.schema.json",
  "name": "Strivacity",
  "abstract": "Customer identity and access management (CIAM) platform for customers, partners and AI agents, delivered as a single product on a dedicated single-instance cloud. Covers self-service registration and account management, passwordless sign-in and passkeys, adaptive MFA, social login and SSO over OIDC and SAML, and organizations for B2B, B2B2x and B2P use cases. Identity orchestration with a no-code journey canvas can be configured or coded through hosted, embedded and native modes and SDKs. Fraud prevention (bot, behavior, device and breached-password detection) and identity verification are built in, with data residency included and a 99.99% standard SLA. Pricing is MAU-based and starts at $17,000 per year.",
  "identifier": "strivacity",
  "status": "active",
  "deploymentModels": ["saas"],
  "targetAudience": ["b2c", "b2b", "ciam"],
  "tags": ["fraud-prevention", "identity-orchestration", "data-residency", "dedicated-instance"],
