  "$schema": "https://schemas.cerberauth.com/identity-provider/draft/2024-09/provider.schema.json",
  "name": "IBM Verify",
  "abstract": "IBM's identity-first platform for workforce and customer identities, sold as the SaaS IBM Verify with self-managed options for hybrid and multi-cloud estates. Covers single sign-on, MFA including passwordless and adaptive AI-driven MFA, provisioning and lifecycle governance, consent management with self-service privacy requests, no-code identity orchestration, identity analytics and governance of AI agent identities. Cites SOC 2, SOC 3, ISO 27001, HIPAA, PCI DSS and OpenID certification, with a FedRAMP offering for government. Usage-based pricing with a free trial and marketplace purchasing on AWS and Azure.",
  "identifier": "ibm-verify",
  "aliases": ["IBM Security Verify"],
  "status": "active",
  "deploymentModels": ["saas", "self_hosted", "hybrid"],
  "targetAudience": ["workforce", "b2c", "ciam"],
