{
  "$schema": "https://schemas.cerberauth.com/identity-provider/draft/2024-09/provider.schema.json",
  "name": "Pocket ID",
  "abstract": "Simple self-hosted OpenID Connect and OAuth 2.0 provider that only supports passwordless sign-in, primarily passkeys. Each app is registered as an OIDC client, and user groups control which users can sign in to which client and are passed to apps in tokens. Admins can issue one-time login codes to enrol a first passkey. Includes LDAP sync and SCIM provisioning, plus authentication proxies for apps without OIDC support. Self-hosted only under BSD-2-Clause, aimed at homelabs and small teams.",
  "identifier": "pocket-id",
  "status": "active",
  "deploymentModels": ["self_hosted"],
  "targetAudience": ["developer", "workforce"],
  "tags": ["go", "homelab", "passkey-only", "lightweight"],
