  "features": [
    {
      "identifier": "username_and_password_authentication",
      "status": "supported",
      "description": "Password login is the default for a new project. Common passwords and breached passwords are blocked, and failed logins are rate-limited.",
      "links": ["https://docs.propelauth.com/overview/authentication/login-methods"]
    },
    {
      "identifier": "social_sign_in_authentication",
      "status": "supported",
      "description": "Apple, Atlassian, GitHub, GitLab, Google, LinkedIn, Microsoft, Outreach, QuickBooks Online, Salesforce, Salesloft, Slack and Xero. Accounts with a matching email are linked automatically.",
      "links": [
        "https://docs.propelauth.com/sso/social-login",
        "https://docs.propelauth.com/overview/authentication/login-methods"
      ]
    },
    {
      "identifier": "passkey_authentication",
      "status": "unknown",
      "description": "Passkeys are listed for the self-hosted BYO Auth sidecar. They are not documented for the hosted login pages.",
      "links": ["https://byo.propelauth.com"]
    },
    {
      "identifier": "email_passwordless_authentication",
      "status": "supported",
      "description": "A login link is emailed to the user. Email OTP login emails exist as a transactional email event.",
      "links": [
        "https://docs.propelauth.com/overview/authentication/login-methods",
        "https://docs.propelauth.com/integrations/webhooks"
      ]
    },
    {
      "identifier": "phone_passwordless_authentication",
      "status": "unknown",
      "description": "SMS or phone login is not documented."
    },
    {
      "identifier": "magic_link_authentication",
      "status": "supported",
      "description": "Links expire after 2 hours by default, with an option to make them single-use or to show an interstitial page. The API can also generate a magic link with an expiry of up to 336 hours, and returns the URL without sending the email.",
      "links": [
        "https://docs.propelauth.com/overview/authentication/login-methods",
        "https://docs.propelauth.com/reference/api/user"
      ]
    },
    {
      "identifier": "anonymous_authentication",
      "status": "unknown"
    },
    {
      "identifier": "totp_mfa",
      "status": "supported",
      "description": "TOTP through an authenticator app is the default MFA type and needs no setup. Users can optionally be remembered on a device for 7 to 90 days.",
      "links": ["https://docs.propelauth.com/overview/authentication/mfa"]
    },
    {
      "identifier": "hotp_mfa",
      "status": "unknown"
    },
    {
      "identifier": "u2f_mfa",
      "status": "unknown"
    },
    {
      "identifier": "webauthn_mfa",
      "status": "unknown",
      "description": "Passkeys and security keys are not documented as a second factor."
    },
    {
      "identifier": "email_code_mfa",
      "status": "unknown"
    },
    {
      "identifier": "phone_code_mfa",
      "status": "supported",
      "description": "SMS MFA works through your own SMS provider. PropelAuth sends a user.send_mfa_phone_code webhook with the code and you deliver it. Not available on the Free plan.",
      "links": ["https://docs.propelauth.com/overview/authentication/mfa", "https://www.propelauth.com/pricing"],
      "plans": ["Growth", "Growth Plus"]
    },
    {
      "identifier": "recovery_code_mfa",
      "status": "supported",
      "description": "Users can view their backup codes from the hosted account page.",
      "links": ["https://docs.propelauth.com/overview/authentication/mfa"]
    },
    {
      "identifier": "push_notification_mfa",
      "status": "unknown"
    },
    {
      "identifier": "adaptive_mfa",
      "status": "unknown"
    },
    {
      "identifier": "cisco_duo_mfa",
      "status": "unknown"
    },
    {
      "identifier": "step_up_authentication",
      "status": "supported",
      "description": "Your app requests a TOTP or SMS challenge before a sensitive action and receives a step-up grant, either one-time or time-based. It is triggered by your own logic, not by risk signals.",
      "links": ["https://docs.propelauth.com/overview/authentication/step-up-mfa"],
      "plans": ["Growth", "Growth Plus"]
    },
    {
      "identifier": "oidc_protocol",
      "status": "supported",
      "description": "PropelAuth can act as an OIDC provider with authorization code flow, PKCE, ID tokens signed with RS256 and a discovery document. MCP authentication uses a separate OAuth 2.1 server.",
      "links": [
        "https://docs.propelauth.com/reference/api/oauth2",
        "https://docs.propelauth.com/mcp-authentication/overview"
      ]
    },
    {
      "identifier": "saml2_protocol",
      "status": "supported",
      "description": "SAML 2.0 as a service provider for customer enterprise SSO connections. Acting as a SAML identity provider is not documented.",
      "links": ["https://docs.propelauth.com/overview/authentication/saml"]
    },
    {
      "identifier": "ws_federation_protocol",
      "status": "unknown"
    },
    {
      "identifier": "machine_to_machine",
      "status": "partial",
      "description": "Personal, organization and generic API keys validated by your backend, labelled API Keys / M2M. The OAuth client credentials grant is not documented.",
      "links": ["https://docs.propelauth.com/api-key-authentication", "https://www.propelauth.com/pricing"],
      "plans": ["Growth", "Growth Plus"]
    },
    {
      "identifier": "oidc_federation",
      "status": "supported",
      "description": "OIDC enterprise SSO per organization, including Okta, Entra ID, Google, OneLogin, JumpCloud, Ping Identity and generic OIDC. Role and property mapping is not yet supported for OIDC connections.",
      "links": ["https://docs.propelauth.com/overview/authentication/saml"],
      "plans": ["Growth", "Growth Plus"]
    },
    {
      "identifier": "saml_federation",
      "status": "supported",
      "description": "SAML enterprise SSO per organization with unlimited connections, set up by customers through self-service UIs. Supports Okta, Entra ID, Google, OneLogin, JumpCloud, Ping Identity, Duo, Rippling and generic SAML. IdP roles and attributes can be mapped to PropelAuth roles and properties.",
      "links": ["https://docs.propelauth.com/overview/authentication/saml", "https://www.propelauth.com/pricing"],
      "plans": ["Growth", "Growth Plus"]
    },
    {
      "identifier": "active_directory_ldap",
      "status": "unknown"
    },
    {
      "identifier": "azure_ad_integration",
      "status": "supported",
      "description": "Entra ID is supported for SAML and OIDC enterprise SSO and for SCIM provisioning.",
      "links": ["https://docs.propelauth.com/overview/authentication/saml"]
    },
    {
      "identifier": "bulk_user_import",
      "status": "supported",
      "description": "CSV import from the dashboard Users page, plus a migration API that creates one user per call.",
      "links": ["https://docs.propelauth.com/migrations", "https://docs.propelauth.com/reference/api/user"]
    },
    {
      "identifier": "password_hash_import",
      "status": "supported",
      "description": "Imported users keep their password through bcrypt, argon2id, pbkdf2_sha256, pbkdf2_sha256_b64 and pbkdf2_sha512 hashes.",
      "links": ["https://docs.propelauth.com/migrations", "https://docs.propelauth.com/reference/api/user"]
    },
    {
      "identifier": "bulk_user_export",
      "status": "unknown"
    },
    {
      "identifier": "bulk_user_update_delete",
      "status": "unknown"
    },
    {
      "identifier": "upsert_on_import",
      "status": "unknown"
    },
    {
      "identifier": "legacy_username_import",
      "status": "unknown"
    },
    {
      "identifier": "mfa_enrollment_import",
      "status": "supported",
      "description": "The migration API accepts a base32 TOTP secret, which enables MFA automatically so existing authenticator codes keep working.",
      "links": ["https://docs.propelauth.com/migrations"]
    },
    {
      "identifier": "inbound_scim_provisioning",
      "status": "supported",
      "description": "SCIM directory sync from Okta, Entra ID, OneLogin, JumpCloud and generic SCIM providers, managed by PropelAuth. Enterprise SSO must be set up first. $100 per connection on Growth Plus.",
      "links": ["https://docs.propelauth.com/overview/authentication/saml", "https://www.propelauth.com/pricing"],
      "plans": ["Growth Plus"]
    },
    {
      "identifier": "outbound_scim_provisioning",
      "status": "unknown"
    },
    {
      "identifier": "scim_groups",
      "status": "supported",
      "description": "SCIM group events are delivered by webhook, such as org.scim_group_created and user.added_to_scim_group.",
      "links": ["https://docs.propelauth.com/integrations/webhooks"],
      "plans": ["Growth Plus"]
    },
    {
      "identifier": "jit_provisioning",
      "status": "supported",
      "description": "The account is created and added to the right organization on first SSO login. An organization can turn it off, for example when it uses SCIM.",
      "links": ["https://docs.propelauth.com/overview/authentication/saml"],
      "plans": ["Growth", "Growth Plus"]
    },
    {
      "identifier": "lazy_migration",
      "status": "partial",
      "description": "The migrateUserFromExternalSource backend call can move a user over on demand, and the original ID is kept as legacy_user_id. A dedicated login-time migration flow is not documented.",
      "links": ["https://docs.propelauth.com/migrations"]
    },
    {
      "identifier": "self_service_profile_management",
      "status": "supported",
      "description": "Hosted account page where users manage their profile, 2FA, backup codes, social account links and API keys.",
      "links": [
        "https://docs.propelauth.com/overview/basics/hosted-pages",
        "https://docs.propelauth.com/overview/authentication/login-methods"
      ]
    },
    {
      "identifier": "account_linking",
      "status": "supported",
      "description": "Social and SSO logins are linked automatically when the email matches. Users can link social accounts with a different email when the setting is enabled.",
      "links": [
        "https://docs.propelauth.com/overview/authentication/login-methods",
        "https://docs.propelauth.com/sso/social-login"
      ]
    },
    {
      "identifier": "user_blocking",
      "status": "supported",
      "description": "Users can be disabled and re-enabled, which stops login and invalidates their personal API keys. Signup can also be restricted with allowlists and blocklists on paid plans.",
