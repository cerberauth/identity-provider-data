{
  "$schema": "https://schemas.cerberauth.com/identity-provider/draft/2024-09/provider.schema.json",
  "name": "Dex",
  "abstract": "Open-source OpenID Connect identity service written in Go that fronts other identity providers through pluggable connectors (LDAP, SAML 2.0, GitHub, GitLab, Google, Microsoft, LinkedIn, upstream OIDC and OAuth 2.0, and others). Applications and Kubernetes only need to speak OpenID Connect, and Dex issues the signed ID tokens. It is a federation layer rather than a user directory, with a local password connector for simple setups, customizable login templates, a gRPC API, and storage on PostgreSQL, MySQL, SQLite, etcd or Kubernetes CRDs. Self-hosted only, under Apache-2.0.",
  "identifier": "dex",
  "status": "active",
  "deploymentModels": ["self_hosted"],
  "targetAudience": ["developer", "workforce"],
