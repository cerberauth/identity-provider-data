{
  "$schema": "https://schemas.cerberauth.com/identity-provider/draft/2024-09/provider.schema.json",
  "name": "Keycloak",
  "abstract": "Open-source (Apache 2.0) IAM/CIAM by Red Hat. Zero licensing cost with unlimited users. Most feature-rich open-source option with full SPI extensibility. Requires self-hosting and DevOps expertise.",
  "identifier": "keycloak",
  "icon": {
    "contentUrl": "https://nacho.cerberauth.com/logos/keycloak.svg"
  },
  "website": "https://www.keycloak.org",
  "github": "https://github.com/keycloak/keycloak",
  "license": "Apache 2.0",
  "nationality": "USA",
  "pricing": {
    "hasFreeTier": true,
    "freeTierLimit": "Unlimited (self-hosted, open source)",
    "pricingModel": "open-source",
    "pricingUrl": "https://www.keycloak.org",
    "plans": [
      {
        "name": "Open Source",
        "price": "Free (self-hosted)"
      },
      {
        "name": "Red Hat SSO",
        "price": "Commercial support available"
      }
    ]
  },
  "features": [
    {
      "identifier": "username_and_password_authentication",
      "status": "supported",
      "links": [
        "https://www.keycloak.org/docs/latest/server_admin/index.html#ref-user-credentials_server_administration_guide"
      ]
    },
    {
      "identifier": "social_sign_in_authentication",
      "status": "supported",
      "description": "12+ built-in providers plus any custom OIDC or SAML identity provider.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#social-identity-providers"]
    },
    {
      "identifier": "passkey_authentication",
      "status": "supported",
      "description": "WebAuthn passwordless and two-factor authentication.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#webauthn_server_administration_guide"]
    },
    {
      "identifier": "email_passwordless_authentication",
      "status": "supported",
      "description": "Email OTP for passwordless authentication.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#one-time-password-otp-policies"]
    },
    {
      "identifier": "phone_passwordless_authentication",
      "status": "partial",
      "description": "Phone OTP via custom SPI extension or third-party provider. No built-in SMS gateway.",
      "links": ["https://github.com/cooperlyt/keycloak-phone-provider"]
    },
    {
      "identifier": "magic_link_authentication",
      "status": "partial",
      "description": "Magic link via custom authenticator SPI. Not available out-of-the-box. The p2-inc/keycloak-magic-link extension is the most widely used community solution.",
      "links": ["https://github.com/p2-inc/keycloak-magic-link"]
    },
    {
      "identifier": "anonymous_authentication",
      "status": "not_supported",
      "description": "Keycloak does not natively support anonymous or guest user authentication sessions. Users must authenticate with credentials or an external identity provider.",
      "links": [
        "https://www.keycloak.org/docs/latest/server_admin/index.html#user-sessions",
        "https://github.com/keycloak/keycloak/discussions"
      ]
    },
    {
      "identifier": "totp_mfa",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#one-time-password-otp-policies"]
    },
    {
      "identifier": "hotp_mfa",
      "status": "supported",
      "description": "HOTP (counter-based OTP) supported alongside TOTP.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#one-time-password-otp-policies"]
    },
    {
      "identifier": "u2f_mfa",
      "status": "supported",
      "description": "WebAuthn security keys for U2F-style authentication.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#webauthn_server_administration_guide"]
    },
    {
      "identifier": "webauthn_mfa",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#webauthn_server_administration_guide"]
    },
    {
      "identifier": "email_code_mfa",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#one-time-password-otp-policies"]
    },
    {
      "identifier": "phone_code_mfa",
      "status": "partial",
      "description": "SMS OTP via SPI extension. No built-in SMS provider.",
      "links": ["https://github.com/cooperlyt/keycloak-phone-provider"]
    },
    {
      "identifier": "recovery_code_mfa",
      "status": "supported",
      "description": "Recovery Codes are a built-in required action since Keycloak 22+. Single-use backup codes generated at MFA enrollment.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_recovery-codes"]
    },
    {
      "identifier": "push_notification_mfa",
      "status": "not_supported",
      "description": "No built-in push notification MFA. Community extensions exist (e.g. ba-itsys/keycloak-push-mfa-extension) but are not officially maintained.",
      "links": ["https://github.com/ba-itsys/keycloak-push-mfa-extension"]
    },
    {
      "identifier": "adaptive_mfa",
      "status": "not_supported",
      "description": "No built-in adaptive/risk-based MFA. Can be implemented via custom SPI or community extensions such as mabartos/keycloak-adaptive-authn.",
      "links": ["https://github.com/mabartos/keycloak-adaptive-authn"]
    },
    {
      "identifier": "cisco_duo_mfa",
      "status": "partial",
      "description": "Cisco Duo provides official SSO integration via OIDC/SAML. For direct authenticator-level integration, the community-maintained instipod/DuoUniversalKeycloakAuthenticator extension (tested with Keycloak 26.x) is available.",
      "links": [
        "https://duo.com/docs/sso-oidc-redhat-keycloak",
        "https://github.com/instipod/DuoUniversalKeycloakAuthenticator"
      ]
    },
    {
      "identifier": "step_up_authentication",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_step-up-flow"]
    },
    {
      "identifier": "oidc_protocol",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#oidc-clients"]
    },
    {
      "identifier": "saml2_protocol",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#saml-clients"]
    },
    {
      "identifier": "ws_federation_protocol",
      "status": "not_supported",
      "description": "WS-Federation is not natively supported. A community extension (cloudtrust/keycloak-wsfed) exists but is not officially maintained or vetted by the Keycloak team.",
      "links": ["https://github.com/cloudtrust/keycloak-wsfed"]
    },
    {
      "identifier": "machine_to_machine",
      "status": "supported",
      "description": "OAuth 2.0 client credentials grant natively supported.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_client-credentials"]
    },
    {
      "identifier": "oidc_federation",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_identity_broker"]
    },
    {
      "identifier": "saml_federation",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_identity_broker"]
    },
    {
      "identifier": "active_directory_ldap",
      "status": "supported",
      "description": "Full LDAP and Active Directory federation with read/write sync.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_ldap"]
    },
    {
      "identifier": "azure_ad_integration",
      "status": "supported",
      "description": "Azure AD/Entra ID federation via OIDC or SAML identity brokering.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_identity_broker"]
    },
    {
      "identifier": "bulk_user_import",
      "status": "supported",
      "description": "Import users via Admin REST API (POST /admin/realms/{realm}/users), Partial Import API, or LDAP sync.",
      "links": ["https://www.keycloak.org/docs-api/latest/rest-api/index.html"]
    },
    {
      "identifier": "password_hash_import",
      "status": "supported",
      "description": "Import password hashes via Admin API with custom hashing algorithm support.",
      "links": ["https://www.keycloak.org/docs-api/latest/rest-api/index.html"]
    },
    {
      "identifier": "bulk_user_export",
      "status": "supported",
      "description": "Export users via Admin REST API or realm export.",
      "links": ["https://www.keycloak.org/docs-api/latest/rest-api/index.html"]
    },
    {
      "identifier": "bulk_user_update_delete",
      "status": "supported",
      "description": "Bulk operations via Admin REST API.",
      "links": ["https://www.keycloak.org/docs-api/latest/rest-api/index.html"]
    },
    {
      "identifier": "upsert_on_import",
      "status": "supported",
      "description": "Partial Import API supports OVERWRITE, SKIP, and FAIL conflict strategies, enabling upsert behavior.",
      "links": ["https://www.keycloak.org/docs-api/latest/rest-api/index.html"]
    },
    {
      "identifier": "legacy_username_import",
      "status": "partial",
      "description": "Keycloak allows customizing username validation regex via the declarative User Profile feature, but legacy usernames containing non-standard special characters or spaces may require custom validator configuration.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_user_profile"]
    },
    {
      "identifier": "mfa_enrollment_import",
      "status": "supported",
      "description": "TOTP secrets can be imported via the JSON realm import format or the admin REST API using the credentials array with fields: secret (BASE32), digits, period, and algorithm.",
      "links": ["https://www.keycloak.org/docs-api/latest/rest-api/index.html"]
    },
    {
      "identifier": "inbound_scim_provisioning",
      "status": "partial",
      "description": "Keycloak 26.6+ includes native SCIM 2.0 API support as an experimental/preview feature (enabled via --features=scim-api). It enables Keycloak to act as a SCIM Service Provider for inbound provisioning of users from IdPs like Microsoft Entra ID.",
      "links": [
        "https://www.keycloak.org/2026/04/scim-as-experimental-feature",
        "https://github.com/Captain-P-Goldfish/scim-for-keycloak"
      ]
    },
    {
      "identifier": "outbound_scim_provisioning",
      "status": "not_supported",
      "description": "Keycloak acts as a SCIM Service Provider (inbound provisioning) and does not natively support outbound SCIM client provisioning to third-party applications.",
      "links": [
        "https://www.keycloak.org/2026/04/scim-as-experimental-feature",
        "https://github.com/keycloak/keycloak/issues/9495"
      ]
    },
    {
      "identifier": "scim_groups",
      "status": "partial",
      "description": "Keycloak 26.6+ SCIM API supports the /Groups endpoint for provisioning and managing group memberships when the experimental --features=scim-api flag is enabled.",
      "links": [
        "https://www.keycloak.org/2026/04/scim-as-experimental-feature",
        "https://github.com/Captain-P-Goldfish/scim-for-keycloak"
      ]
    },
    {
      "identifier": "jit_provisioning",
      "status": "supported",
      "description": "JIT user provisioning during first federation login.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_identity_broker_first_login"]
    },
    {
      "identifier": "lazy_migration",
      "status": "supported",
      "description": "Lazy migration via User Storage SPI for gradual migration from existing user stores.",
      "links": ["https://www.keycloak.org/docs/latest/server_development/index.html#_user-storage-spi"]
    },
    {
      "identifier": "self_service_profile_management",
      "status": "supported",
      "description": "Keycloak Account Console for self-service profile, MFA, and session management.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#using-the-account-console"]
    },
    {
      "identifier": "account_linking",
      "status": "supported",
      "description": "Link multiple identity providers to a single Keycloak account.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_account-linking"]
    },
    {
      "identifier": "user_blocking",
      "status": "supported",
      "description": "Disable user accounts to prevent authentication via the Admin Console or Admin REST API.",
      "links": [
        "https://www.keycloak.org/docs/latest/server_admin/index.html#assembly-managing-users_server_administration_guide"
      ]
    },
    {
      "identifier": "user_metadata",
      "status": "supported",
      "description": "Custom user attributes stored as user attributes in Keycloak.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#user-profile"]
    },
    {
      "identifier": "app_metadata",
      "status": "supported",
      "description": "Client attributes (custom metadata per client/application) can be stored via the Admin REST API.",
      "links": ["https://www.keycloak.org/docs-api/latest/rest-api/index.html"]
    },
    {
      "identifier": "metadata_size_limits",
      "status": "partial",
      "description": "User attribute value lengths in Keycloak are bounded by underlying database column definitions (defaulting to 2048 characters for unmanaged attributes) rather than configurable per-tenant policies.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#user-attributes"]
    },
    {
      "identifier": "user_search",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#searching-for-users"]
    },
    {
      "identifier": "rbac",
      "status": "supported",
      "description": "Realm roles and client roles with composite roles support.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#assigning-permissions-and-roles-to-users"]
    },
    {
      "identifier": "organizations_multitenancy",
      "status": "supported",
      "description": "Organizations feature (since v26.0) and Realms for full tenant isolation.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_managing_organizations"]
    },
    {
      "identifier": "password_strength_policy",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#password-policies"]
    },
    {
      "identifier": "username_restrictions",
      "status": "supported",
      "description": "Username validation via user profile validators (regex, length) configurable per realm.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#user-profile"]
    },
    {
      "identifier": "progressive_profiling",
      "status": "supported",
      "description": "Progressive profiling supported since Keycloak v24.0.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#user-profile"]
    },
    {
      "identifier": "abac",
      "status": "supported",
      "description": "Attribute-based access control via Keycloak Authorization Services.",
      "links": ["https://www.keycloak.org/docs/latest/authorization_services/index.html"]
    },
    {
      "identifier": "fine_grained_authorization",
      "status": "supported",
      "description": "Resource, scope, and policy-based authorization via Keycloak Authorization Services.",
      "links": ["https://www.keycloak.org/docs/latest/authorization_services/index.html"]
    },
    {
      "identifier": "api_authorization",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/authorization_services/index.html"]
    },
    {
      "identifier": "soc2_type2",
      "status": "unknown",
      "description": "Keycloak is open-source self-hosted software. SOC 2 Type II compliance depends entirely on the hosting infrastructure, cloud provider, and operational controls of the deploying organization.",
      "links": ["https://www.keycloak.org/security", "https://access.redhat.com/articles/2483861"]
    },
    {
      "identifier": "iso_27001",
      "status": "unknown",
      "description": "Keycloak is open-source software. ISO 27001 certification applies to the organization and cloud environment operating Keycloak rather than the standalone software codebase.",
      "links": ["https://www.keycloak.org/security", "https://access.redhat.com/articles/2483861"]
    },
    {
      "identifier": "hipaa_baa",
      "status": "unknown",
      "description": "Keycloak is self-hosted software. HIPAA compliance and BAA agreements are established with the underlying cloud hosting provider and operating entity.",
      "links": ["https://www.keycloak.org/security", "https://access.redhat.com/articles/2483861"]
    },
    {
      "identifier": "pci_dss",
      "status": "unknown",
      "description": "Keycloak is open-source software. PCI DSS compliance validation depends on the hosting architecture and deployment security controls.",
      "links": ["https://www.keycloak.org/security", "https://access.redhat.com/articles/2483861"]
    },
    {
      "identifier": "csa_star",
      "status": "unknown",
      "description": "Keycloak is open-source software. CSA STAR certification applies to cloud service providers hosting the software.",
      "links": ["https://www.keycloak.org/security", "https://access.redhat.com/articles/2483861"]
    },
    {
      "identifier": "fedramp",
      "status": "unknown",
      "description": "Keycloak is open-source software. It is frequently deployed within FedRAMP-authorized cloud environments (e.g., AWS GovCloud, Red Hat OpenShift), but the open-source project itself does not hold a centralized FedRAMP authorization.",
      "links": ["https://www.keycloak.org/security", "https://access.redhat.com/articles/2483861"]
    },
    {
      "identifier": "gdpr_data_export",
      "status": "supported",
      "description": "Export user data via Admin REST API.",
      "links": ["https://www.keycloak.org/docs-api/latest/rest-api/index.html#UsersResource"]
    },
    {
      "identifier": "gdpr_right_to_erasure",
      "status": "supported",
      "description": "Delete user accounts and associated data via Admin REST API (DELETE /admin/realms/{realm}/users/{id}) or Admin Console.",
      "links": [
        "https://www.keycloak.org/docs/latest/server_admin/index.html#proc-deleting-user_server_administration_guide"
      ]
    },
    {
      "identifier": "consent_management",
      "status": "supported",
      "description": "OAuth 2.0 consent screen and scope management built-in.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#openid-connect-scopes"]
    },
    {
      "identifier": "region_deployment",
      "status": "supported",
      "description": "Self-hosted deployment anywhere with cross-datacenter replication support.",
      "links": ["https://www.keycloak.org/high-availability/introduction"]
    },
    {
      "identifier": "private_cloud_deployment",
      "status": "supported",
      "description": "Self-host on AWS (EC2, EKS, ROSA), Azure (VMs, AKS), GCP, or any other cloud.",
      "values": ["AWS", "Azure", "GCP"],
      "links": ["https://www.keycloak.org/guides#server"]
    },
    {
      "identifier": "audit_log_retention",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#event-listener"]
    },
    {
      "identifier": "audit_log_streaming",
      "status": "partial",
      "description": "Event listener SPI supports syslog, JSON, and Gelf log handlers.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#event-listener"]
    },
    {
      "identifier": "security_center",
      "status": "not_supported",
      "description": "Keycloak does not have a built-in SIEM or threat monitoring security dashboard. Security and login events can be logged and forwarded to external monitoring systems (ELK, Splunk, Grafana) via Event Listener SPI.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_events"]
    },
    {
      "identifier": "encryption_at_rest",
      "status": "supported",
      "description": "Encryption at rest via database-level Transparent Data Encryption (TDE) or filesystem/block-device encryption. Operator-dependent; Keycloak itself does not encrypt data at rest by default.",
      "links": ["https://www.keycloak.org/server/db"]
    },
    {
      "identifier": "encryption_in_transit",
      "status": "supported",
      "description": "TLS/HTTPS is supported and configurable. Keycloak recommends TLS for all traffic.",
      "links": ["https://www.keycloak.org/server/enabletls"]
    },
    {
      "identifier": "customer_managed_keys",
      "status": "supported",
      "description": "Manage your own encryption keys via the deployment infrastructure.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_keys"]
    },
    {
      "identifier": "bot_detection",
      "status": "partial",
      "description": "Built-in Google reCAPTCHA support for registration flows (v2 and v3, including reCAPTCHA Enterprise). Login flow CAPTCHA requires a community extension. Third-party privacy-friendly CAPTCHA providers (Friendly Captcha, ALTCHA) are available via extensions.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#enabling-recaptcha"]
    },
    {
      "identifier": "brute_force_protection",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#password-guess-brute-force-attacks"]
    },
    {
      "identifier": "suspicious_ip_throttling",
      "status": "partial",
      "description": "Brute force detection locks accounts per user after repeated failures. Native per-IP throttling across multiple accounts is not built-in; a reverse proxy or WAF is recommended for IP-level rate limiting.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#password-guess-brute-force-attacks"]
    },
    {
      "identifier": "breached_password_detection",
      "status": "not_supported",
      "description": "No built-in HaveIBeenPwned integration. Community extensions are available (e.g. alvinbaena/keycloak-pwned-password-policy). Keycloak does support a password blacklist feature that can use the HIBP list.",
      "links": ["https://github.com/alvinbaena/keycloak-pwned-password-policy"]
    },
    {
      "identifier": "credential_guard",
      "status": "not_supported",
      "description": "Keycloak does not include native dark web compromised credential monitoring out-of-the-box. Breached password checks can be enabled using custom SPIs or password blacklists.",
      "links": [
        "https://www.keycloak.org/docs/latest/server_admin/index.html#password-policies",
        "https://github.com/alvinbaena/keycloak-pwned-password-policy"
      ]
    },
    {
      "identifier": "tenant_acl",
      "status": "partial",
      "description": "IP allow/deny lists are not built into the core Quarkus-based Keycloak distribution. This capability was removed from the legacy distribution. Per-realm IP filtering is available via deployment infrastructure (reverse proxy, WAF) or some managed Keycloak hosting providers.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_authentication-flows"]
    },
    {
      "identifier": "device_fingerprinting",
      "status": "not_supported",
      "description": "Keycloak does not provide native device fingerprinting or behavioral risk scoring. User sessions record client IP address and user-agent string.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#user-sessions"]
    },
    {
      "identifier": "per_org_branding",
      "status": "supported",
      "description": "Per-realm (tenant) FreeMarker theming for custom branding.",
      "links": ["https://www.keycloak.org/docs/latest/server_development/index.html#_themes"]
    },
    {
      "identifier": "per_org_mfa_policy",
      "status": "supported",
      "description": "Per-realm MFA policies and authentication flows.",
      "links": ["https://www.keycloak.org/docs/latest/server_admin/index.html#_authentication-flows"]
    },
    {
      "identifier": "hosted_login_page",
      "status": "supported",
      "links": ["https://www.keycloak.org/docs/latest/server_development/index.html#_themes"]
    },
    {
      "identifier": "embedded_login",
      "status": "partial",
      "description": "Direct grant API allows credential-based flows for embedded auth. Hosted redirect flow is standard.",
      "links": [
        "https://www.keycloak.org/docs/latest/server_admin/index.html#resource-owner-password-credentials-grant-legacy"
      ]
    },
    {
      "identifier": "white_label",
      "status": "supported",
      "description": "Full FreeMarker theming enables complete brand customization.",
      "links": ["https://www.keycloak.org/docs/latest/server_development/index.html#_themes"]
    },
    {
      "identifier": "localization",
      "status": "supported",
      "description": "20+ built-in language packs with custom translation support.",
      "links": ["https://www.keycloak.org/docs/latest/server_development/index.html#_themes"]
    },
    {
