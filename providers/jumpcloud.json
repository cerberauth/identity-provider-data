    "isOpenSource": false
  },
  "governance": "vendor_led",
  "nationality": "USA",
  "vendor": {
    "name": "JumpCloud",
    "url": "https://jumpcloud.com"
  },
  "pricing": {
    "hasFreeTier": false,
    "pricingModel": "per_user",
    "pricingUrl": "https://jumpcloud.com/pricing",
    "hasEnterprisePlan": true,
    "contactSalesRequired": true,
    "currency": "USD",
    "pricingLastVerified": "2026-10-24",
    "trialDays": 30,
    "plans": [
      {
        "name": "Device Management",
        "price": "$9/user/month billed annually, $11 billed monthly"
      },
      {
        "name": "SSO",
        "price": "$11/user/month billed annually, $13 billed monthly. Includes SSO, MFA and a password manager"
      },
      {
        "name": "Device Identity Management",
        "price": "$13/user/month billed annually, $15 billed monthly"
      },
      {
        "name": "Platform Essentials",
        "price": "Contact sales. Capped at 300 users"
      },
      {
        "name": "Platform",
        "price": "Contact sales"
      },
      {
        "name": "Platform Prime",
        "price": "Contact sales. Adds Zero Trust, AI and SaaS management and premium support"
      }
    ]
  },
