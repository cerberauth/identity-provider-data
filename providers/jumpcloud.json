{
  "$schema": "https://schemas.cerberauth.com/identity-provider/draft/2024-09/provider.schema.json",
  "name": "JumpCloud",
  "abstract": "Commercial cloud directory and open directory platform that combines identity, access and device management. Provides single sign-on over SAML and OIDC with an application catalog and custom applications, MFA, passwordless sign-in, a cloud directory with LDAP and RADIUS, user lifecycle management, conditional access and device management. Sold per user per month as packages or a la carte, with a 30-day free trial. Aimed at small and mid-sized workforces rather than customer-facing apps.",
  "identifier": "jumpcloud",
  "status": "active",
  "deploymentModels": ["saas"],
  "targetAudience": ["workforce"],
  "tags": ["directory", "mdm", "device-management", "radius", "ldap"],
  "icon": {
    "contentUrl": "https://nacho.cerberauth.com/logos/jumpcloud.svg"
  },
  "website": "https://jumpcloud.com",
  "documentationUrl": "https://jumpcloud.com/support",
  "license": "Proprietary",
