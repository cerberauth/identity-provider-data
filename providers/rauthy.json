  "$schema": "https://schemas.cerberauth.com/identity-provider/draft/2024-09/provider.schema.json",
  "name": "Rauthy",
  "abstract": "Open-source OpenID Connect and OAuth 2.0 provider written in Rust, small enough to run from a single binary with an embedded Hiqlite database or PostgreSQL. Supports passkey-only accounts, forced MFA, upstream login providers, SCIM v2, the device authorization grant, DPoP, dynamic and ephemeral (CIMD) clients, and RP-initiated and back-channel logout. Self-hosted only under Apache-2.0, maintained mostly by a single developer, with paid support by email and an independent security audit addressed in v0.32.1.",
  "identifier": "rauthy",
  "status": "active",
  "deploymentModels": ["self_hosted"],
  "targetAudience": ["developer", "workforce"],
  "tags": ["rust", "lightweight", "single-binary"],
