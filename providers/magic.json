  "features": [
    {
      "identifier": "username_and_password_authentication",
      "status": "not_supported",
      "description": "Magic is passwordless only. The documented login methods are email OTP, SMS OTP, social login, passkeys, Farcaster and external wallets.",
      "links": ["https://docs.magic.link/embedded-wallets/authentication/overview.md"]
    },
    {
      "identifier": "social_sign_in_authentication",
      "status": "supported",
      "description": "Google, Facebook, X, Apple, Discord, GitHub, LinkedIn, Bitbucket, Twitch, Microsoft, GitLab, Telegram and Steam through OAuth. Email-based access control only works for providers that return the email address.",
      "links": ["https://docs.magic.link/embedded-wallets/authentication/login/oauth/implementation.md"]
    },
    {
      "identifier": "passkey_authentication",
      "status": "supported",
      "description": "WebAuthn passkeys through the Passkey extension of the web SDK: register, log in, and list, add, rename or remove passkeys. No other SDK is documented for passkeys.",
      "links": ["https://docs.magic.link/embedded-wallets/authentication/login/passkey.md"]
    },
    {
      "identifier": "email_passwordless_authentication",
      "status": "supported",
      "description": "Email one-time passcode login on the web, React Native, iOS, Android and Flutter SDKs, with a prebuilt modal or a custom UI.",
      "links": ["https://docs.magic.link/embedded-wallets/authentication/login/email-otp.md"]
    },
    {
      "identifier": "phone_passwordless_authentication",
      "status": "supported",
      "description": "SMS one-time passcode login on all client SDKs. Phone numbers with the +7, +53, +98, +375, +850 and +963 country codes are blocked because of spam, and those users can sign in by email.",
      "links": [
        "https://docs.magic.link/embedded-wallets/authentication/login/sms.md",
        "https://docs.magic.link/home/faq.md"
      ]
    },
    {
      "identifier": "magic_link_authentication",
      "status": "unknown",
      "description": "The FAQ and some pages still mention a login link in the email next to the OTP, but the documentation index no longer has a magic link login page. Email OTP is the documented method.",
      "links": ["https://docs.magic.link/home/faq.md"]
    },
    {
      "identifier": "anonymous_authentication",
      "status": "unknown"
    },
    {
      "identifier": "totp_mfa",
      "status": "supported",
      "description": "Authenticator-app MFA (Authy, Google Authenticator) with opt-in enrollment per user through the SDK settings modal. Works with email, SMS and social primary logins on the web, React Native, iOS and Android SDKs, but not with white-label login flows.",
      "links": ["https://docs.magic.link/embedded-wallets/authentication/features/mfa.md"],
      "plans": ["Startup", "Enterprise"]
    },
    {
      "identifier": "hotp_mfa",
      "status": "unknown"
    },
    {
      "identifier": "u2f_mfa",
      "status": "unknown"
    },
    {
      "identifier": "webauthn_mfa",
      "status": "supported",
      "description": "Passkey as a second factor after email OTP or OAuth login, with recovery codes. Available in the web SDK only, and users can pick between TOTP and passkey when both are enrolled.",
      "links": ["https://docs.magic.link/embedded-wallets/authentication/features/passkey-mfa.md"],
      "plans": ["Startup", "Enterprise"]
    },
    {
      "identifier": "email_code_mfa",
      "status": "unknown"
    },
    {
      "identifier": "phone_code_mfa",
      "status": "unknown",
      "description": "The MFA documentation says SMS is not available as a second factor, while the pricing page lists SMS under Enterprise advanced MFA.",
      "links": ["https://docs.magic.link/embedded-wallets/authentication/features/mfa.md", "https://magic.link/pricing"]
    },
    {
      "identifier": "recovery_code_mfa",
      "status": "supported",
      "description": "Single-use recovery codes are issued at MFA enrollment. Using one deactivates MFA for that device. Developers can also disable MFA for a user from the dashboard.",
      "links": [
        "https://docs.magic.link/embedded-wallets/authentication/features/mfa.md",
        "https://docs.magic.link/embedded-wallets/authentication/features/passkey-mfa.md"
