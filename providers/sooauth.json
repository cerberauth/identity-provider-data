  "features": [
    {
      "identifier": "username_and_password_authentication",
      "status": "supported",
      "description": "Passwords hashed with Argon2id. Projects choose the allowed identifiers (email, username or phone) and whether password is the primary sign-in mode.",
      "links": [
        "https://github.com/sooapps/sooauth/blob/main/server/internal/crypto/password/password.go",
        "https://github.com/sooapps/sooauth/blob/main/server/migrations/00023_tenant_auth_config_and_registration_schema.sql"
      ]
    },
    {
      "identifier": "social_sign_in_authentication",
      "status": "partial",
      "description": "Google and GitHub only. Facebook and X appear in the provider settings and pricing page, but the server only implements the Google and GitHub OAuth flows. No custom OAuth or OIDC providers.",
      "links": [
        "https://github.com/sooapps/sooauth/blob/main/server/internal/social/service.go",
        "https://github.com/sooapps/sooauth/blob/main/server/internal/httpserver/server.go"
      ]
    },
    {
      "identifier": "passkey_authentication",
      "status": "supported",
      "description": "WebAuthn passkey registration and sign-in from the hosted pages, with passkeys listed and removed from the account page.",
      "links": [
        "https://github.com/sooapps/sooauth/blob/main/server/internal/passkeys/service.go",
        "https://github.com/sooapps/sooauth#readme"
      ]
    },
    {
      "identifier": "email_passwordless_authentication",
      "status": "partial",
      "description": "An OTP endpoint stores a 6-digit code for 5 minutes and emits an otp.sent webhook, but the server does not deliver the code by email and the webhook payload does not carry it.",
      "links": ["https://github.com/sooapps/sooauth/blob/main/server/internal/httpserver/app_auth.go"]
    },
    {
