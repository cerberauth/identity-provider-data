  "features": [
    {
      "identifier": "username_and_password_authentication",
      "status": "supported",
      "description": "Email and password authentication with 8-character minimum and top 1,000,000 common passwords blocked.",
      "links": ["https://docs.kinde.com/authenticate/about-auth/authentication-methods/"],
      "plans": ["Free", "Pro", "Plus", "Scale", "Enterprise"]
    },
    {
      "identifier": "social_sign_in_authentication",
      "status": "supported",
      "description": "Google, GitHub, Microsoft, Apple, Discord, and more. Accounts are automatically linked across providers that share a verified email address.",
      "links": ["https://docs.kinde.com/authenticate/about-auth/authentication-methods/"],
      "plans": ["Free", "Pro", "Plus", "Scale", "Enterprise"]
    },
    {
      "identifier": "passkey_authentication",
      "status": "not_supported",
      "description": "Passkey authentication is in development and listed on Kinde's roadmap but not yet available.",
