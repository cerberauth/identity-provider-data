{
  "$schema": "https://schemas.cerberauth.com/identity-provider/draft/2024-09/provider.schema.json",
  "name": "Corbado",
  "abstract": "Commercial passkey adoption platform that sits next to an existing identity provider rather than replacing it. Corbado Observe adds authentication observability, with process mining, per-user debugging and readiness insights. Corbado Connect runs a FIDO-certified passkey server with managed sign-up and sign-in, rollout controls with safe fallbacks and analytics, while the customer keeps its own IdP, user store and sessions. Integrates with Okta, Auth0, Ping, Cognito, ForgeRock and Entra. ISO 27001 and SOC 2 Type II certified. Pricing is custom, based on usage, deployment and support.",
  "identifier": "corbado",
  "status": "active",
  "deploymentModels": ["saas"],
  "targetAudience": ["b2c", "ciam", "developer"],
  "tags": ["passkeys", "passwordless", "observability"],
