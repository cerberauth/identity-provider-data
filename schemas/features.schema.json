{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cerberauth.com/identity-provider/draft/2024-09/features.schema.json",
  "title": "Features Definition List",
  "description": "Schema for feature definitions catalogs in CerberAuth identity provider data.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the feature catalog.",
      "minLength": 1
    },
    "featureList": {
      "type": "array",
      "description": "List of feature definitions.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name of the feature.",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "Description of what the feature provides."
          },
          "identifier": {
            "type": "string",
            "description": "Unique machine-readable identifier of the feature.",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "description": "Category identifier that this feature belongs to.",
            "pattern": "^[a-z0-9_]+$",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "description": "Default status of the feature.",
            "enum": [
              "supported",
              "not_supported",
              "partial",
              "deprecated",
              "planned",
              "unknown"
            ]
          },
          "tier": {
            "type": "string",
            "description": "Complexity tier classification for the feature.",
            "enum": [
              "basic",
              "standard",
              "advanced",
              "enterprise"
            ]
          },
          "links": {
            "type": "array",
            "description": "Specification or documentation reference URLs for this feature.",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "required": [
          "name",
          "description",
          "identifier",
          "category",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "featureList"
  ],
  "additionalProperties": false
}
